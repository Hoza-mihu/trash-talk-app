# Flask Configuration
FLASK_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here
HOST=0.0.0.0
PORT=5000

# Model Configuration
# Leave MODEL_PATH empty to use default: backend/model/model.h5
# MODEL_PATH=backend/model/model.h5

# ML Provider Configuration
# Set ML_PROVIDER to use alternative ML services instead of custom model
# Options: huggingface, openai, google, tensorflow_hub
# Leave empty to use custom model if available
ML_PROVIDER=huggingface

# Hugging Face (Free tier available - works without API key for public models)
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL_ID=microsoft/resnet-50

# OpenAI Vision API (Required if using OpenAI provider)
OPENAI_API_KEY=

# Google Cloud Vision API (Required if using Google provider)
GOOGLE_CLOUD_API_KEY=

# TensorFlow Hub (Optional - uses default if not set)
TFHUB_MODEL_URL=

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# File Upload
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Firebase (if using)
FIREBASE_ADMIN_SDK=

